import { useState, useRef, useEffect } from "react";
import { formatPrice, formatDate, getStatusColor, imageUrl, cn } from "@/lib/utils";
import type { Order, OrderStatus } from "@/lib/types";
import {
  ChevronLeft,
  Calendar,
  CreditCard,
  User,
  Clock,
  AlertCircle,
  ExternalLink,
  Loader2,
  Check,
  ChevronDown,
  MessageSquare,
  Package,
} from "lucide-react";

type View = "list" | "detail";

const ORDER_STATUSES = ["pending", "confirmed", "processing", "shipped", "delivered", "completed", "cancelled"] as const;

function OrderHeader({
  order,
  onBack,
  canManageOrders,
  onStatusChange,
  updating,
  updateError,
}: {
  order: Order;
  onBack: () => void;
  canManageOrders: boolean;
  onStatusChange: (newStatus: string) => void;
  updating: boolean;
  updateError: string;
}) {
  const listing = order.items?.[0]?.listing;
  const primaryImage = listing?.primary_image?.image_url || listing?.images?.[0]?.image_url;

  const handleOrderStatusChange = async (newStatus: string) => {
    if (newStatus === order.status || updating) return;
    onStatusChange(order.id, newStatus);
  };

  return (
    <header className="border-b border-gray-100 p-6">
      <nav className="mb-6">
        <button
          onClick={onBack}
          className="flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-900 transition-colors"
          aria-label="Back to orders"
        >
          <ChevronLeft className="w-4 h-4" /> Back to Orders
        </button>
      </nav>

<div className="flex items-start justify-between gap-4 mb-6">
        <div>
          <h1 className="text-xl font-bold text-gray-900">Order #{order.order_number}</h1>
          <p className="text-sm text-gray-500 mt-1">Placed on {formatDate(order.placed_at)}</p>
        </div>

        <div aria-label="Order status">
          {canManageOrders ? (
            <DropdownMenu
              current={order.status}
              options={ORDER_STATUSES}
              onChange={handleOrderStatusChange}
              triggerClassName="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1 rounded-full capitalize"
              aria-label="Change order status"
            />
          ) : (
            <span
               className={cn(
                 "inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1 rounded-full capitalize",
                 getStatusColor(order.status),
               )}
               aria-label={`Order status: ${order.status}`}
             >
              {order.status.replace("_", " ")}
            </span>
          )}
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div className="md:col-span-2">
          <h2 className="font-semibold text-gray-900 hover:text-blue-600 transition-colors text-sm md:text-base">
            {listing?.year} {listing?.make?.name} {listing?.model?.name}
          </h2>
          <div className="flex flex-wrap items-center gap-4 mt-2" role="list">
            {listing?.mileage && (
              <div className="flex items-center gap-1 text-xs md:text-sm text-gray-500" role="listitem">
                <Calendar className="w-3.5 h-3.5" aria-hidden="true" />
                {listing.mileage.toLocaleString()} mi
              </div>
            )}
            {listing?.vin && (
              <div className="flex items-center gap-1 text-xs md:text-sm text-gray-400" role="listitem">
                <CreditCard className="w-3.5 h-3.5" aria-hidden="true" />
                VIN: {listing.vin}
              </div>
            )}
          </div>
        </div>

        <div className="flex items-center justify-end">
          {listing && (
            <figure className="relative w-full aspect-video overflow-hidden bg-gray-100">
              {primaryImage ? (
                <img
                  src={imageUrl(primaryImage)}
                  alt={`${listing.year} ${listing.make?.name} ${listing.model?.name}`}
                  className="w-full h-full object-cover"
                />
              ) : (
                <div className="w-full h-full flex items-center justify-center text-gray-300">
                  <Package className="w-8 h-8" aria-hidden="true" />
                </div>
              )}
            </figure>
          )}
        </div>
      </div>

      {updateError && (
        <div className="mt-4 bg-red-50 border border-red-200 text-red-600 px-4 py-3 flex items-center gap-2 text-sm rounded-lg" role="alert">
          <AlertCircle className="w-4 h-4 shrink-0" aria-hidden="true" /> {updateError}
        </div>
      )}
    </header>
  );
}

function SellerSection({ order }: { order: Order }) {
  const listing = order.items?.[0]?.listing;

  return (
    <div className="border-b border-gray-100 p-6">
      <h2 className="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-3">
        Seller
      </h2>
      <div className="flex items-center gap-3">
        <div className="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
          {order.seller?.avatar_url ? (
            <img
              src={imageUrl(order.seller.avatar_url)}
              alt=""
              className="w-full h-full rounded-full object-cover"
            />
          ) : (
            <User className="w-5 h-5 text-gray-400" />
          )}
        </div>
        <div>
          <p className="text-sm font-medium text-gray-900">
            {order.seller?.dealer_name ||
              order.seller?.full_name ||
              "Unknown"}
          </p>
          {order.seller?.location && (
            <p className="text-xs text-gray-500">
              {order.seller.location}
            </p>
          )}
        </div>
        {order.seller?.is_dealer && (
          <span className="text-[11px] font-medium text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full ml-auto">
            Dealer
          </span>
        )}
        {listing?.id && (
          <button
            onClick={() => (window.location.href = `/messages?seller=${order.seller?.id}&listing=${listing.id}`)}
            className="ml-auto inline-flex items-center gap-1.5 px-4 py-2 bg-gray-900 text-white text-sm font-medium rounded-lg hover:bg-gray-800 transition-colors"
          >
            <MessageSquare className="w-4 h-4" />
            Message Seller
          </button>
        )}
      </div>
    </div>
  );
}

function PaymentSection({ order }: { order: Order }) {
  return (
    <div className="border-b border-gray-100 p-6">
      <h2 className="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">
        Payment
      </h2>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div className="space-y-3">
          <div className="flex justify-between items-center py-2 border-b border-gray-50">
            <span className="text-gray-500 text-sm">Method</span>
            <span className="font-medium capitalize text-gray-900">
              {order.payment_method || "N/A"}
            </span>
          </div>
          {order.payment_method === "finance" && (
            <>
              {order.down_payment != null && (
                <div className="flex justify-between items-center py-2 border-b border-gray-50">
                  <span className="text-gray-500 text-sm">Down Payment</span>
                  <span className="font-medium text-gray-900">
                    {formatPrice(order.down_payment)}
                  </span>
                </div>
              )}
              {order.loan_term != null && (
                <div className="flex justify-between items-center py-2 border-b border-gray-50">
                  <span className="text-gray-500 text-sm">Loan Term</span>
                  <span className="font-medium text-gray-900">
                    {order.loan_term} months
                  </span>
                </div>
              )}
              {order.monthly_payment != null && (
                <div className="flex justify-between items-center py-2 border-b border-gray-50">
                  <span className="text-gray-500 text-sm">Monthly Payment</span>
                  <span className="font-medium text-gray-900">
                    {formatPrice(order.monthly_payment)}
                  </span>
                </div>
              )}
            </>
          )}
        </div>
        {order.payment_method === "finance" && (
          <div className="bg-gray-50 rounded-lg p-4">
            <h3 className="text-xs font-semibold text-gray-900 uppercase tracking-wider mb-3">
              Financing Summary
            </h3>
            <div className="space-y-2 text-xs">
              {order.down_payment != null && (
                <div className="flex justify-between">
                  <span className="text-gray-600">Down Payment</span>
                  <span className="font-medium text-gray-900">
                    {formatPrice(order.down_payment)}
                  </span>
                </div>
              )}
              {order.loan_term != null && (
                <div className="flex justify-between">
                  <span className="text-gray-600">Loan Duration</span>
                  <span className="font-medium text-gray-900">
                    {order.loan_term} months
                  </span>
                </div>
              )}
              {order.monthly_payment != null && (
                <div className="flex justify-between">
                  <span className="text-gray-600">Monthly Installment</span>
                  <span className="font-medium text-gray-900">
                    {formatPrice(order.monthly_payment)}
                  </span>
                </div>
              )}
              {order.loan_term != null && order.monthly_payment != null && (
                <div className="pt-2 border-t border-gray-200">
                  <div className="flex justify-between text-xs font-semibold">
                    <span className="text-gray-900">Total Financed</span>
                    <span className="text-gray-900">
                      {formatPrice((order.monthly_payment * order.loan_term) + (order.down_payment || 0))}
                    </span>
                  </div>
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

function InvoiceSection({ order }: { order: Order }) {
  return (
    <div className="border-b border-gray-100 p-6">
      <h2 className="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-3">
        Invoice
      </h2>
      <div className="space-y-2 text-sm">
        <div className="flex justify-between">
          <span className="text-gray-500">Subtotal</span>
          <span className="text-gray-900">
            {formatPrice(order.subtotal)}
          </span>
        </div>
        {order.accessories && order.accessories.length > 0 && (
          <div className="pl-4 space-y-1">
            {order.accessories.map((acc, i) => (
              <div
                key={i}
                className="flex justify-between text-xs text-gray-500"
              >
                <span>{acc.name}</span>
                <span>{formatPrice(acc.price)}</span>
              </div>
            ))}
          </div>
        )}
        <div className="flex justify-between">
          <span className="text-gray-500">Tax</span>
          <span className="text-gray-900">{formatPrice(order.tax)}</span>
        </div>
        <div className="flex justify-between">
          <span className="text-gray-500">Fees</span>
          <span className="text-gray-900">{formatPrice(order.fees)}</span>
        </div>
        <div className="border-t border-gray-100 pt-2 flex justify-between font-semibold">
          <span className="text-gray-900">Total</span>
          <span className="text-gray-900">
            {formatPrice(order.total)}
          </span>
        </div>
      </div>
    </div>
  );
}

const getInstallmentStatusIcon = (status: string) => {
  switch (status) {
    case "paid":
      return <Check className="w-3 h-3" />;
    case "overdue":
      return <AlertCircle className="w-3 h-3" />;
    default:
      return <Clock className="w-3 h-3" />;
  }
};

const getInstallmentStatusLabel = (status: string) => {
  switch (status) {
    case "paid":
      return "Paid";
    case "overdue":
      return "Overdue";
    default:
      return "Pending";
  }
};

function InstallmentsDropdown({
  order,
  canManageOrders,
  onInstallmentChange,
}: {
  order: Order;
  canManageOrders: boolean;
  onInstallmentChange: (installmentId: string, newStatus: string) => void;
}) {
  if (!order.installments || order.installments.length === 0) {
    return null;
  }

  return (
    <div className="border-b border-gray-100 p-6">
      <div className="flex items-center justify-between mb-4">
        <h2 className="text-sm font-semibold text-gray-900 uppercase tracking-wider">
          Installments ({order.installments.length})
        </h2>
        {canManageOrders && (
          <div className="text-xs text-gray-500">
            Click status to update
          </div>
        )}
      </div>
      <div className="relative inline-block w-full">
        <DropdownMenu
          current={null}
          options={order.installments.map((inst) => inst.id)}
          onChange={(selectedId) => {
            const selectedInst = order.installments.find((inst) => inst.id === selectedId);
            if (selectedInst) {
              const newStatus = selectedInst.status === "paid" ? "pending" : selectedInst.status === "pending" ? "paid" : "overdue";
              onInstallmentChange(selectedInst.id, newStatus);
            }
          }}
          triggerClassName="w-full inline-flex items-center justify-between px-4 py-3 border border-gray-200 rounded-lg bg-white hover:bg-gray-50 transition-colors"
          itemClassName="px-4 py-3"
          getLabel={(id) => {
            const inst = order.installments.find((i) => i.id === id);
            return inst
              ? `${inst.month_number} - ${formatDate(inst.due_at)} - ${formatPrice(inst.amount)} - ${getInstallmentStatusLabel(inst.status)}`
              : id;
          }}
        />
      </div>
    </div>
  );
}

const InstallmentsTable = InstallmentsDropdown;

function NotesSection({ order }: { order: Order }) {
  if (!order.notes) return null;

  return (
    <div className="border-b border-gray-100 p-6">
      <h2 className="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-2">
        Notes
      </h2>
      <p className="text-sm text-gray-600">{order.notes}</p>
    </div>
  );
}

function OrderFooter({ order }: { order: Order }) {
  const listing = order.items?.[0]?.listing;

  return (
    <div className="p-6 bg-gray-50 flex items-center justify-between">
      <div className="text-xs text-gray-400">
        Order ID: {order.id}
        {order.completed_at && (
          <span className="ml-4">
            Completed: {formatDate(order.completed_at)}
          </span>
        )}
      </div>
      {listing?.id && (
        <a
          href={`/listings/${listing.id}`}
          className="inline-flex items-center gap-1.5 text-sm text-gray-600 hover:text-gray-900 transition-colors"
        >
          <ExternalLink className="w-3.5 h-3.5" /> View Listing
        </a>
      )}
    </div>
  );
}

function DropdownMenu<T extends string>({
  current,
  options,
  onChange,
  triggerClassName = "",
  itemClassName = "",
  getLabel = (opt: T) => opt.replace("_", " "),
}: {
  current: T;
  options: readonly T[];
  onChange: (value: T) => void;
  triggerClassName?: string;
  itemClassName?: string;
  getLabel?: (opt: T) => string;
}) {
  const [open, setOpen] = useState(false);
  const [search, setSearch] = useState("");
  const ref = useRef<HTMLDivElement>(null);

  useEffect(() => {
    function handleClickOutside(e: MouseEvent) {
      if (ref.current && !ref.current.contains(e.target as Node)) {
        setOpen(false);
      }
    }
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  const filteredOptions = options.filter((option) =>
    getLabel(option).toLowerCase().includes(search.toLowerCase())
  );

  return (
    <div className="relative inline-block" ref={ref}>
      <div className="relative">
        <input
          type="text"
          value={search ? getLabel(current) : ""}
          onChange={(e) => {
            setSearch(e.target.value);
            setOpen(true);
          }}
          onFocus={() => setOpen(true)}
          className={cn(
            "w-full text-xs font-medium px-3 py-1.5 rounded-md border border-gray-200 bg-white hover:bg-gray-50 transition-all duration-200",
            "focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
            triggerClassName,
          )}
          placeholder="Select status..."
          aria-expanded={open}
          aria-haspopup="listbox"
        />
        <button
          onClick={() => {
            setOpen(!open);
            if (!open) setSearch("");
          }}
          className="absolute right-1 top-1/2 -translate-y-1/2 p-1 hover:bg-gray-100 rounded transition-colors"
          aria-label="Toggle dropdown"
        >
          <ChevronDown
            className={cn(
              "w-3 h-3 transition-transform duration-200",
              open && "rotate-180"
            )}
          />
        </button>
      </div>
      {open && (
        <div
          className="absolute left-0 right-0 top-full mt-1 z-50 bg-white border border-gray-200 rounded-md shadow-lg overflow-hidden transform origin-top transition-all duration-200 ease-out"
          style={open ? { opacity: 1, transform: 'translateY(0)' } : { opacity: 0, transform: 'translateY(-10px)' }}
        >
          {filteredOptions.length > 0 ? (
            filteredOptions.map((option) => (
              <button
                key={option}
                onClick={() => {
                  onChange(option);
                  setOpen(false);
                  setSearch("");
                }}
                className={cn(
                  "w-full flex items-center gap-2 px-3 py-2 text-xs text-left hover:bg-gray-50 transition-all duration-150",
                  option === current && "bg-gray-50 font-semibold",
                  itemClassName,
                )}
              >
                <span
                  className={cn(
                    "w-2 h-2 rounded-full shrink-0",
                    getStatusColor(option as string).split(" ")[0] || "bg-gray-300",
                  )}
                />
                <span>{getLabel(option)}</span>
                {option === current && (
                  <Check className="w-3 h-3 ml-auto text-gray-400" />
                )}
              </button>
            ))
          ) : (
            <div className="px-3 py-2 text-xs text-gray-500">No options found</div>
          )}
        </div>
      )}
    </div>
  );
}

export {
  OrderHeader,
  SellerSection,
  PaymentSection,
  InvoiceSection,
  InstallmentsTable,
  NotesSection,
  OrderFooter,
  DropdownMenu,
  getInstallmentStatusIcon,
  getInstallmentStatusLabel,
};
